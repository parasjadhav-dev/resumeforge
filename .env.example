# Copy this file to .env and fill in real values. Never commit .env.

# --- Database (Neon / Postgres) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Optional: direct (non-pooled) Neon URL, used only for migrations
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Auth (NextAuth) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- LLM (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Optional: override the model (default: gemini-3.5-flash-lite)
# GEMINI_MODEL="gemini-3.5-flash-lite"
# Per-user daily cap on LLM calls (enforced in a later step)
LLM_DAILY_LIMIT_PER_USER="30"
